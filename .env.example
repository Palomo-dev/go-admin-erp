# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-key
STRIPE_SECRET_KEY=sk_live_your-secret-key

# OpenExchangeRates API
NEXT_PUBLIC_OPENEXCHANGERATES_API_KEY=your-api-key

# Cron Job Security Token (generate a random secure token)
# This token is used to authenticate automatic cron job requests
# Generate with: openssl rand -base64 32
CRON_SECRET=your-secure-random-token-here

# Google Maps Platform
# Obtener en: https://console.cloud.google.com/google/maps-apis/credentials
# APIs requeridas: Directions API, Geocoding API, Places API, Distance Matrix API, Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# SendGrid Email Integration
# Clave pública ECDSA para verificar webhooks de SendGrid
# Se obtiene en: Settings > Mail Settings > Event Webhook > Verification Key
SENDGRID_WEBHOOK_VERIFICATION_KEY=your-ecdsa-public-key

# Google Ads Integration (OAuth 2.0 + Developer Token)
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_ADS_CLIENT_ID=your-google-ads-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-google-ads-client-secret
# Developer Token: https://ads.google.com/aw/apicenter (requiere aprobación de Google)
GOOGLE_ADS_DEVELOPER_TOKEN=your-22-char-developer-token
# Solo si usas MCC (Manager Account) - ID sin guiones
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# TripAdvisor Content API
# Obtener en: https://www.tripadvisor.com/developers
# Primeras 5,000 llamadas/mes gratis (requiere tarjeta de crédito)
TRIPADVISOR_API_KEY=your-tripadvisor-api-key

# DIAN / RUES Lookup Integration (autocompletar datos de cliente/proveedor)
# Proveedor primario: "verifik" (firma digital, RUES completo) o "coresoft" (menor costo)
# Documentacion: https://docs.verifik.co | https://coresoft.solutions/api-rut.html
DIAN_PROVIDER=verifik
VERIFIK_TOKEN=your-verifik-bearer-token
CORESOFT_API_KEY=your-coresoft-api-key

# Production Domain (for reference)
NEXT_PUBLIC_APP_URL=https://app.goadmin.io

# Sellers Portal URL
NEXT_PUBLIC_SELLERS_URL=https://sellers.goadmin.io

# WhatsApp QR (Evolution API) – Gateway self-hosted
# Ref: docs/integraciones/whatsapp-qr-evolution.md
# Evolution API es un gateway construido sobre Baileys con manejo correcto de LID,
# persistencia Redis/DB y API REST estable. Documentación: https://doc.evolution-api.com
# EVOLUTION_API_URL: URL base de Evolution API (default http://localhost:8080)
# EVOLUTION_API_KEY: API key global configurada en Evolution API (AUTHENTICATION_API_KEY)
# NEXT_PUBLIC_APP_URL: URL pública del ERP (para configurar webhook de Evolution API)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (web + electron + capacitor comparten el mismo DSN)
SENTRY_DSN=https://your-sentry-dsn@oXXXXX.ingest.sentry.io/XXXXX
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@oXXXXX.ingest.sentry.io/XXXXX

# Web Push (PWA) - VAPID keys para notificaciones push en navegador instalado
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:servicio@goadmin.io

# ──────────────────────────────────────────────────────────────
# CRM Revenue OS — FASE-00 §3.4 Variables de entorno
# ──────────────────────────────────────────────────────────────

# Supabase service-role (webhooks y operaciones server-side sin sesión)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — Chat, transcripción, análisis
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Twilio — Voz, SMS, WhatsApp
TWILIO_ACCOUNT_SID=ACyour-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_API_KEY=SKyour-api-key
TWILIO_API_SECRET=your-twilio-api-secret
TWILIO_TWIML_APP_SID=APyour-twiml-app-sid
TWILIO_PHONE_NUMBER=+57your-phone-number
TWILIO_WHATSAPP_NUMBER=whatsapp:+57your-whatsapp-number
TWILIO_VERIFY_SERVICE_SID=VAyour-verify-service-sid
TWILIO_WEBHOOK_BASE_URL=https://app.goadmin.io
TWILIO_PUSH_CREDENTIAL_SID_IOS=CRyour-ios-push-credential
TWILIO_PUSH_CREDENTIAL_SID_ANDROID=CRyour-android-push-credential

# WebSocket server (Realtime API F6)
WS_SERVER_URL=wss://app.goadmin.io
WS_PORT=8080

# Deepgram — STT alternativo
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-3

# ElevenLabs — Scribe (STT) + TTS
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_SCRIBE_MODEL=scribe_v2

# Resend — Email transaccional y marketing
RESEND_API_KEY=re_your-resend-key
RESEND_WEBHOOK_SECRET=whsec_your-webhook-secret

# Google AI — Gemini análisis + Chirp 3
GOOGLE_AI_API_KEY=your-google-ai-key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=your-meta-access-token

# SendGrid — Fallback email
SENDGRID_API_KEY=SG.your-sendgrid-key

# Cal.com — Agendamiento (F10)
CALCOM_API_KEY=your-calcom-api-key

# Daily — Video demo (F10)
DAILY_API_KEY=your-daily-api-key

# Documenso — Firma electrónica (F10)
DOCUMENSO_API_KEY=your-documenso-api-key

# Apollo — Enriquecimiento B2B (F14)
APOLLO_API_KEY=your-apollo-api-key

# PostHog — Analítica de producto (F11)
POSTHOG_KEY=phc_your-posthog-key

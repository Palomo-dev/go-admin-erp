# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-key
STRIPE_SECRET_KEY=sk_live_your-secret-key

# OpenExchangeRates API
NEXT_PUBLIC_OPENEXCHANGERATES_API_KEY=your-api-key

# Cron Job Security Token (generate a random secure token)
# This token is used to authenticate automatic cron job requests
# Generate with: openssl rand -base64 32
CRON_SECRET=your-secure-random-token-here

# Google Maps Platform
# Obtener en: https://console.cloud.google.com/google/maps-apis/credentials
# APIs requeridas: Directions API, Geocoding API, Places API, Distance Matrix API, Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# SendGrid Email Integration
# Clave pública ECDSA para verificar webhooks de SendGrid
# Se obtiene en: Settings > Mail Settings > Event Webhook > Verification Key
SENDGRID_WEBHOOK_VERIFICATION_KEY=your-ecdsa-public-key

# Google Ads Integration (OAuth 2.0 + Developer Token)
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_ADS_CLIENT_ID=your-google-ads-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-google-ads-client-secret
# Developer Token: https://ads.google.com/aw/apicenter (requiere aprobación de Google)
GOOGLE_ADS_DEVELOPER_TOKEN=your-22-char-developer-token
# Solo si usas MCC (Manager Account) - ID sin guiones
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# TripAdvisor Content API
# Obtener en: https://www.tripadvisor.com/developers
# Primeras 5,000 llamadas/mes gratis (requiere tarjeta de crédito)
TRIPADVISOR_API_KEY=your-tripadvisor-api-key

# DIAN / RUES Lookup Integration (autocompletar datos de cliente/proveedor)
# Proveedor primario: "verifik" (firma digital, RUES completo) o "coresoft" (menor costo)
# Documentacion: https://docs.verifik.co | https://coresoft.solutions/api-rut.html
DIAN_PROVIDER=verifik
VERIFIK_TOKEN=your-verifik-bearer-token
CORESOFT_API_KEY=your-coresoft-api-key

# Production Domain (for reference)
NEXT_PUBLIC_APP_URL=https://app.goadmin.io

# Sellers Portal URL
NEXT_PUBLIC_SELLERS_URL=https://sellers.goadmin.io

# WhatsApp QR (Evolution API) – Gateway self-hosted
# Ref: docs/integraciones/whatsapp-qr-evolution.md
# Evolution API es un gateway construido sobre Baileys con manejo correcto de LID,
# persistencia Redis/DB y API REST estable. Documentación: https://doc.evolution-api.com
# EVOLUTION_API_URL: URL base de Evolution API (default http://localhost:8080)
# EVOLUTION_API_KEY: API key global configurada en Evolution API (AUTHENTICATION_API_KEY)
# NEXT_PUBLIC_APP_URL: URL pública del ERP (para configurar webhook de Evolution API)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (web + electron + capacitor comparten el mismo DSN)
SENTRY_DSN=https://your-sentry-dsn@oXXXXX.ingest.sentry.io/XXXXX
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@oXXXXX.ingest.sentry.io/XXXXX

# Web Push (PWA) - VAPID keys para notificaciones push en navegador instalado
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:servicio@goadmin.io

# ──────────────────────────────────────────────────────────────
# CRM Revenue OS V4 — Integraciones por proveedor y fase
# Fuente: docs/crm-revenue-os/FASE-00-FUNDACIONES.md §4.6 y ANEXO-B §9.3
# Convención: los valores "your-…" son PLACEHOLDERS y el registry
# (src/lib/services/providerRegistry.ts) los trata como NO configurados.
# Cualquier org puede sobreescribir estas claves en Configuración › CRM ›
# Proveedores e IA (tabla provider_configs, solo lectura server-side).
# ──────────────────────────────────────────────────────────────

# ── Supabase (server) ──
# service-role: webhooks, jobs, ws-server y lectura de credenciales. NUNCA en cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App / cron / ws-server (F0) ──
# NEXT_PUBLIC_APP_URL: origin público del ERP (links de baja, ICS, callbacks). Ya definido arriba.
# CRON_SECRET: Bearer para /api/crm/jobs/run (pg_cron/pg_net y Vercel cron). Sin él → 401. Ya definido arriba.
# WS_SESSION_SECRET: HMAC-SHA256 de los tokens de sesión ConversationRelay (<Parameter>). Vive en Vercel y Railway.
WS_SESSION_SECRET=your-ws-session-secret
# GATE_COOKIE_SECRET: HMAC-SHA256 de la cookie ga_gate del middleware (veredicto de acceso
#   cacheado 60s: organización, suscripción y módulos verificados). Sin firma, el cliente
#   podría fabricarla y saltarse la verificación de módulos. Si NO está definida, el caché
#   se desactiva y el middleware consulta siempre (más lento, igual de seguro).
#   Generar con: openssl rand -base64 32
GATE_COOKIE_SECRET=your-gate-cookie-secret
# WS_SERVER_URL: host wss:// del ws-server (Railway) que Next.js escribe en el TwiML <ConversationRelay url="…">.
#   Solo esquema+host, sin path: la app añade la ruta. Ej. wss://go-admin-erp-production.up.railway.app
WS_SERVER_URL=wss://your-ws-server.up.railway.app
# WS_PUBLIC_URL: la MISMA URL pública, pero la lee el ws-server para reconstruir la URL firmada (X-Twilio-Signature) en el upgrade.
WS_PUBLIC_URL=wss://your-ws-server.up.railway.app
WS_PORT=8080

# ── Twilio (F0 firma · F3 voz · F5 bridge móvil · F16 SMS/WA alternativo) ──
# Cuenta master de la plataforma (valida webhooks y crea subcuentas)
TWILIO_MASTER_ACCOUNT_SID=ACyour-master-account-sid
TWILIO_MASTER_AUTH_TOKEN=your-master-auth-token
# Alias legacy = master (se eliminan en F3 cuando todos los call sites usen *_MASTER_*)
TWILIO_ACCOUNT_SID=ACyour-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# API Key (existentes; fallback env para orgs sin provider_configs(voice)): REST, AccessToken del SDK, Basic Auth de grabaciones
TWILIO_API_KEY=SKyour-api-key
TWILIO_API_SECRET=your-twilio-api-secret
# TwiML App (existente): outgoingApplicationSid del VoiceGrant (por org en comm_settings.voice_twiml_app_sid)
TWILIO_TWIML_APP_SID=APyour-twiml-app-sid
# Caller ID / senders globales de fallback
TWILIO_PHONE_NUMBER=+57your-phone-number
# Si es 'true', una organizacion sin numero propio puede marcar con el numero global
# de la plataforma. Por defecto false: la llamada se rechaza y se pide configurar
# un numero de la organizacion (evita que el identificador de llamada sea ajeno).
VOICE_ALLOW_PLATFORM_CALLER_ID=false
TWILIO_WHATSAPP_NUMBER=whatsapp:+57your-whatsapp-number
TWILIO_MESSAGING_SERVICE_SID=MGyour-messaging-service-sid
TWILIO_VERIFY_SERVICE_SID=VAyour-verify-service-sid
# TWILIO_WEBHOOK_BASE_URL: ORIGIN PURO del ERP (esquema + host, SIN path y SIN barra final), p. ej. https://app.goadmin.io
#   Todas las rutas se construyen como `${origin}/api/voice/…` o `${origin}/api/integrations/twilio/…` y la firma
#   X-Twilio-Signature se valida contra esa URL exacta. En desarrollo usar un túnel https (ngrok/cloudflared).
TWILIO_WEBHOOK_BASE_URL=https://app.goadmin.io
# Push credentials para el softphone nativo (F5)
TWILIO_PUSH_CREDENTIAL_SID_IOS=CRyour-ios-push-credential
TWILIO_PUSH_CREDENTIAL_SID_ANDROID=CRyour-android-push-credential

# ── OpenAI (F4 análisis fallback · F6 cerebro del agente · F7 redacción) ──
OPENAI_API_KEY=sk-your-openai-key
# Modelo por defecto para tareas baratas (análisis, redacción, clasificación)
OPENAI_MODEL=gpt-5.6-luna
OPENAI_CHEAP_MODEL=gpt-5.6-luna
# Cerebro del agente de voz (ws-server)
OPENAI_CONVERSATION_MODEL=gpt-5.6-terra
# STT de tercer nivel (sin diarización)
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Solo si se usa el SIP connector de Realtime (experimental, fuera del path crítico)
OPENAI_WEBHOOK_SECRET=
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# ── Google Gemini (F4 análisis primario + STT fallback · F6 LLM alternativo) ──
# Existente: el repo lee GOOGLE_AI_API_KEY (callAnalysisService.ts, providerRegistry.ts). GEMINI_API_KEY se acepta como alias.
GOOGLE_AI_API_KEY=your-google-ai-key
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-3.8-flash

# ── ElevenLabs (F4 Scribe v2 STT primario · F6 TTS/IVC/ElevenAgents) ──
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_SCRIBE_MODEL=scribe_v2
# Modelo TTS por defecto (la voz es por org en `voices`, F6)
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_WEBHOOK_SECRET=your-elevenlabs-webhook-secret
# Id del webhook de Scribe v2 (F4). Sin el, la rama asincrona para audios largos
# queda inalcanzable (callAiPolicy.asyncWebhook = false).
ELEVENLABS_STT_WEBHOOK_ID=your-elevenlabs-stt-webhook-id

# Tope de cuerpo de peticion del DESPLIEGUE, en bytes (F4 N6).
# Los adaptadores de transcripcion aceptan mucho mas que la plataforma que los
# sirve: ElevenLabs admite 1 GB y Gemini 2 GB, pero una funcion serverless de
# Vercel corta el cuerpo de la peticion muy por debajo (4,5 MB en el runtime de
# Node). Sin este numero, un 413 puede prometer al usuario un tamano que la
# plataforma nunca va a dejar subir.
# El servicio debe publicar el MINIMO entre el tope de la cadena y este valor.
# Dejalo vacio en despliegues sin limite propio (servidor propio, contenedor).
# ATENCION: subir este numero NO amplia el limite real de Vercel; solo cambia lo
# que se le promete al usuario. Para archivos grandes hay que subir al bucket
# directamente y pasar la referencia, no el archivo por la ruta de API.
MAX_REQUEST_BODY_BYTES=4718592

# ── Deepgram (legacy: se retira en F4) ──
# transcriptionService.ts (nova-2) es el path vivo hoy; NO borrar antes de migrar a Scribe v2 (F4).
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-2

# ── Resend (F7 email transaccional + marketing) ──
# Key full_access del team (dominios, api keys, webhooks, fallback de envío); por org se crea una sending_access en provider_configs
RESEND_API_KEY=re_your-resend-key
RESEND_WEBHOOK_SECRET=whsec_your-webhook-secret

# Email — dominio global de respaldo y firma de bajas (F7)
# EMAIL_GLOBAL_DOMAIN: dominio verificado en Resend que usa la plataforma cuando
# una organización aún no ha verificado el suyo (política configurable por org).
EMAIL_GLOBAL_DOMAIN=mail.goadmin.io
EMAIL_GLOBAL_FROM_NAME=GoAdmin
# Secreto HMAC para firmar los enlaces públicos de baja (/u/[token]).
EMAIL_UNSUBSCRIBE_SECRET=cambia-esto-por-un-secreto-largo
# Clave AES-256-GCM para cifrar en reposo las API keys por dominio de Resend (F7).
# 32 bytes en hexadecimal o base64. Si no esta, la clave se DERIVA de
# EMAIL_UNSUBSCRIBE_SECRET o de SUPABASE_SERVICE_ROLE_KEY y las credenciales SI se
# guardan (cifradas). Anadirla o rotarla despues no invalida lo ya guardado mientras
# el secreto anterior siga en el entorno: cada valor lleva el id de la clave que lo
# cifro y se re-cifra con la principal en la primera lectura. Si se pierden TODAS las
# claves, la UI marca la credencial como ilegible y hay que regenerar la API key.
EMAIL_CREDENTIALS_SECRET=cambia-esto-por-32-bytes-en-hex
# Modelo usado por "Redactar con IA" en el compositor de correo.
OPENAI_EMAIL_DRAFT_MODEL=gpt-5.6-luna
# Solo para pruebas de integración en vivo (jest): RUN_LIVE=1 LIVE_ORG=105
# RUN_LIVE=
# LIVE_ORG=
# Remitente global de fallback si la org no tiene dominio verificado
EMAIL_FROM_NAME=GO Admin
EMAIL_FROM_ADDRESS=notificaciones@goadmin.io

# ── Meta WhatsApp Cloud API (F16 canal primario; Embedded Signup) ──
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id
# hub.verify_token del webhook (alias legacy: META_WEBHOOK_VERIFY_TOKEN)
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# Token/phone_number_id globales SOLO para pruebas; en producción viven por canal en channel_credentials
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── SendGrid (legacy notificaciones; se retira cuando F7 migre) ──
SENDGRID_API_KEY=SG.your-sendgrid-key

# ── Calendario / otros (fases posteriores, opcionales) ──
CALCOM_API_KEY=your-calcom-api-key
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
DAILY_API_KEY=your-daily-api-key
DOCUMENSO_API_KEY=your-documenso-api-key
APOLLO_API_KEY=your-apollo-api-key

# ── Observabilidad ──
# SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN ya definidos arriba
LOG_LEVEL=info

# ── Eliminadas en V4 (no usar) ──
# OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview  (modelo apagado 2026-05-07; Realtime queda experimental)
# ELEVENLABS_VOICE_ID   (la voz es por org en `voices`)
# GOOGLE_APPLICATION_CREDENTIALS (no se usa service account; solo API key)
# WHATSAPP_APP_SECRET   → META_APP_SECRET
# POSTHOG_KEY           (sin uso)

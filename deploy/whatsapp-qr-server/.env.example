# ============================================================
# Evolution API v2 – Variables de entorno
# Ref: https://doc.evolution-api.com
# ============================================================

# ─── Servidor ───────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:8080
PORT=8080

# ─── Autenticación ──────────────────────────────────────────────────────────
# API key global. Debe coincidir con EVOLUTION_API_KEY del ERP.
# Generar con: openssl rand -base64 32
AUTHENTICATION_API_KEY=your-evolution-api-key

# ─── Base de datos (PostgreSQL requerido en v2) ─────────────────────────────
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution_pass@evolution-postgres:5432/evolution_db?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

# ─── Datos a persistir en BD ────────────────────────────────────────────────
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# ─── Redis (recomendado para cache y estabilidad) ───────────────────────────
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379
CACHE_REDIS_SAVE_INSTANCES=true

# ─── Webhook events ─────────────────────────────────────────────────────────
# Eventos que se envían al webhook configurado en cada instancia
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_QRCODE_UPDATED=true

# ─── QRCODE ─────────────────────────────────────────────────────────────────
# Tiempo de expiración del QR en segundos
QRCODE_LIMIT=300

# ─── Tipos de integración disponibles ───────────────────────────────────────
# Solo Baileys (QR scan). Cloud API se maneja separadamente en el ERP.
INTEGRATIONS=WHATSAPP-BAILEYS

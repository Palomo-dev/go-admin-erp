{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleDetection": "legacy",
    "declaration": false,
    "sourceMap": true,
    "paths": {
      "@print-agent/*": ["../print-agent/src/*"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.js"]
}

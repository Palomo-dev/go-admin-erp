/**
 * F13 — datos del panel del vendedor (`/app/inicio`, sección «Mi panel»).
 * Solo servidor: cliente de sesión por parámetro (RLS) + organización de la
 * sesión. Tablas y columnas verificadas por MCP el 2026-09-15:
 * `sales_targets`, `commissions(payee_id, accrued_at)`,
 * `opportunities(salesperson_id, status, closed_at, amount, stage_id→stages)`,
 * `tasks(assigned_to, due_date, status)`, `organization_members(user_id,
 * is_active)`, `profiles(first_name, last_name)`, `organizations(timezone)`,
 * `organization_currencies(currency_code, is_base)`.
 */

import type { SupabaseClient } from '@supabase/supabase-js';
import { plainDateToInstant, todayInTz } from '@/lib/utils/dateDisplay';
import { DEFAULT_TIMEZONE } from '@/lib/utils/timezone';
import { addDaysPlain, computeQuotaProgress, periodBoundsFor, type QuotaProgress } from './quotaProgress';
import { assertNoDbError, calculateAchievedAmount, getOrgBaseCurrency, type SalesTarget } from './salesTargetService';
import {
  buildLeaderboard,
  pickCurrentQuota,
  summarizeMonthCommissionsByCurrency,
  tasksDueOn,
  topOpenOpportunities,
  type LeaderboardEntry,
  type MonthCommissionRow,
  type MonthCommissionSummary,
  type MonthCurrencySummary,
} from './sellerDashboardModel';

export interface SellerOpportunity {
  id: string;
  name: string;
  amount: number | null;
  currency: string | null;
  expected_close_date: string | null;
  stage_name: string | null;
}

export interface SellerTask {
  id: string;
  title: string;
  due_date: string | null;
  priority: string | null;
  status: string | null;
}

export interface SellerDashboard {
  today: string;
  timezone: string;
  /** Moneda base de la organización; `null` si no está configurada. */
  currency: string | null;
  month_start: string;
  month_end: string;
  quota: { target: SalesTarget; progress: QuotaProgress } | null;
  /** Solo la moneda base (o la más frecuente si no hay base). */
  commissions: MonthCommissionSummary;
  /** Comisiones del mes en OTRAS monedas, cada una aparte: nunca se suman a `commissions`. */
  commissions_others: MonthCurrencySummary[];
  opportunities: SellerOpportunity[];
  tasks_today: SellerTask[];
  /** `null` cuando el rol de sesión no puede ver el ranking (resuelto en servidor). */
  leaderboard: LeaderboardEntry[] | null;
}

const TOP_OPPORTUNITIES = 5;

/** Zona horaria de la organización (`organizations.timezone`, NOT NULL). */
export async function getOrgTimezone(orgId: number, supabase: SupabaseClient): Promise<string> {
  const { data, error } = await supabase.from('organizations').select('timezone').eq('id', orgId).maybeSingle();
  return (!error && (data?.timezone as string | undefined)) || DEFAULT_TIMEZONE;
}

interface MemberName {
  user_id: string;
  name: string;
}

async function listActiveMembers(orgId: number, supabase: SupabaseClient): Promise<MemberName[]> {
  const { data: members, error: membersError } = await supabase
    .from('organization_members')
    .select('user_id')
    .eq('organization_id', orgId)
    .eq('is_active', true);
  assertNoDbError('organization_members', membersError);
  const ids = (members || []).map((m: { user_id: string }) => m.user_id);
  if (ids.length === 0) return [];
  const { data: profiles, error: profilesError } = await supabase.from('profiles').select('id, first_name, last_name, email').in('id', ids);
  assertNoDbError('profiles', profilesError);
  const byId = new Map<string, { first_name: string | null; last_name: string | null; email: string | null }>();
  for (const p of (profiles || []) as Array<{ id: string; first_name: string | null; last_name: string | null; email: string | null }>) byId.set(p.id, p);
  return ids.map((id) => {
    const p = byId.get(id);
    const name = `${p?.first_name || ''} ${p?.last_name || ''}`.trim() || p?.email || 'Miembro';
    return { user_id: id, name };
  });
}

export interface SellerDashboardOptions {
  /** Ya resuelto en servidor con `canSeeLeaderboard(ctx)`. */
  includeLeaderboard: boolean;
}

export async function getSellerDashboard(
  orgId: number,
  userId: string,
  tz: string,
  supabase: SupabaseClient,
  opts: SellerDashboardOptions
): Promise<SellerDashboard> {
  const today = todayInTz(tz);
  const { period_start: monthStart, period_end: monthEnd } = periodBoundsFor('monthly', today);
  const monthFrom = plainDateToInstant(monthStart, tz, '00:00');
  const monthTo = plainDateToInstant(addDaysPlain(monthEnd, 1), tz, '00:00');
  const dayFrom = plainDateToInstant(today, tz, '00:00');
  const dayTo = plainDateToInstant(addDaysPlain(today, 1), tz, '00:00');

  const [currency, targetsRes, commissionsRes, oppsRes, tasksRes] = await Promise.all([
    getOrgBaseCurrency(orgId, supabase),
    supabase.from('sales_targets').select('*').eq('organization_id', orgId).eq('user_id', userId).lte('period_start', today).gte('period_end', today),
    supabase
      .from('commissions')
      .select('status, commission_amount, currency')
      .eq('organization_id', orgId)
      .eq('payee_id', userId)
      .gte('accrued_at', monthFrom)
      .lt('accrued_at', monthTo),
    supabase
      .from('opportunities')
      .select('id, name, amount, currency, expected_close_date, status, stages(name)')
      .eq('organization_id', orgId)
      .eq('salesperson_id', userId)
      .eq('status', 'open'),
    supabase
      .from('tasks')
      .select('id, title, due_date, priority, status')
      .eq('organization_id', orgId)
      .eq('assigned_to', userId)
      .in('status', ['open', 'in_progress'])
      .gte('due_date', dayFrom)
      .lt('due_date', dayTo),
  ]);

  // Ronda 2: un error de BD se propaga (502 honesto); una lista vacía por error mentiría.
  assertNoDbError('sales_targets', targetsRes.error);
  assertNoDbError('commissions', commissionsRes.error);
  assertNoDbError('opportunities', oppsRes.error);
  assertNoDbError('tasks', tasksRes.error);

  const targets = (targetsRes.data || []) as SalesTarget[];
  const current = pickCurrentQuota(targets, today);
  let quota: SellerDashboard['quota'] = null;
  if (current) {
    const achieved = await calculateAchievedAmount(orgId, userId, current.target_type, current.period_start, current.period_end, supabase, tz);
    quota = {
      target: { ...current, achieved_amount: achieved },
      progress: computeQuotaProgress({
        target_amount: Number(current.target_amount),
        achieved_amount: achieved,
        period_start: current.period_start,
        period_end: current.period_end,
        today,
      }),
    };
  }

  type OppRow = { id: string; name: string; amount: number | null; currency: string | null; expected_close_date: string | null; status: string | null; stages: { name: string } | { name: string }[] | null };
  const opportunities = topOpenOpportunities((oppsRes.data || []) as OppRow[], TOP_OPPORTUNITIES).map((o) => ({
    id: o.id,
    name: o.name,
    amount: o.amount == null ? null : Number(o.amount),
    currency: o.currency,
    expected_close_date: o.expected_close_date,
    stage_name: Array.isArray(o.stages) ? o.stages[0]?.name ?? null : o.stages?.name ?? null,
  }));

  const tasksToday = tasksDueOn((tasksRes.data || []) as SellerTask[], today, tz);

  let leaderboard: LeaderboardEntry[] | null = null;
  if (opts.includeLeaderboard) {
    const [members, wonRes] = await Promise.all([
      listActiveMembers(orgId, supabase),
      supabase
        .from('opportunities')
        .select('salesperson_id, amount')
        .eq('organization_id', orgId)
        .eq('status', 'won')
        .gte('closed_at', monthFrom)
        .lt('closed_at', monthTo),
    ]);
    assertNoDbError('opportunities', wonRes.error);
    leaderboard = buildLeaderboard((wonRes.data || []) as Array<{ salesperson_id: string | null; amount: number | null }>, members, userId);
  }

  const monthCommissions = summarizeMonthCommissionsByCurrency((commissionsRes.data || []) as MonthCommissionRow[], currency);
  const { accrued, paid, total, count } = monthCommissions.primary;

  return {
    today,
    timezone: tz,
    currency,
    month_start: monthStart,
    month_end: monthEnd,
    quota,
    commissions: { accrued, paid, total, count },
    commissions_others: monthCommissions.others,
    opportunities,
    tasks_today: tasksToday,
    leaderboard,
  };
}
